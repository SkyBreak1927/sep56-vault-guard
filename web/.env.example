# Copy to `.env.local` and fill in. External links default to the destinations
# in src/config/site.ts; these override them. In-page anchors fall back to
# #section ids.
# NEXT_PUBLIC_* values are inlined into the client bundle at build time.

# NEXT_PUBLIC_LINK_WHY_IT_MATTERS=#why-it-matters
# NEXT_PUBLIC_LINK_TRY_IT=#try-it
# NEXT_PUBLIC_RUN_CHECKS_URL=#try-it
# e.g. https://github.com/SkyBreak1927/sep56-vault-guard
NEXT_PUBLIC_GITHUB_URL=
# Documentation link in the header and footer (default: VAULT_CHECKS.md)
NEXT_PUBLIC_DOCS_URL=
# e.g. https://github.com/stellar/stellar-protocol/blob/master/ecosystem/sep-0056.md
NEXT_PUBLIC_SEP56_SPEC_URL=
# e.g. https://github.com/stellar/stellar-protocol/blob/master/ecosystem/sep-0041.md
NEXT_PUBLIC_SEP41_SPEC_URL=

# Absolute origin for share-preview image URLs, e.g. https://aegis-vault.vercel.app.
# On Vercel this defaults to the project's production domain.
NEXT_PUBLIC_SITE_URL=

# Check-suite backend (server/). Locally: run it with PORT=4000
# ALLOWED_ORIGINS=http://localhost:3000 and set http://localhost:4000 here.
# e.g. https://aegis-vault-backend.onrender.com
NEXT_PUBLIC_API_BASE=

# YouTube walkthrough for "Already have a vault?" (watch or youtu.be URL). Hidden until set.
NEXT_PUBLIC_CHECK_VIDEO_URL=

# Supabase Auth. Read by the browser client, server code and src/proxy.ts (the
# session lives in cookies). Publishable key only — it's public by design.
# A future secret key goes in a plain (non-NEXT_PUBLIC_) server-only var.
# Unset: the auth pages say sign-in isn't configured.
# e.g. https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
